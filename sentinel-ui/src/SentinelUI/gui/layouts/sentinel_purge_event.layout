PanelWidgetClass SentinelUIPurgeRoot
{
    ignorepointer 1
    position 0 0
    size 1 1
    hexactpos 0
    vexactpos 0
    hexactsize 0
    vexactsize 0
    {
        PanelWidgetClass SentinelUIPurgePanel
        {
            ignorepointer 1
            position 0.285 0.25
            size 0.43 0.20
            hexactpos 0
            vexactpos 0
            hexactsize 0
            vexactsize 0
            color 0.18 0.01 0.02 0.94
            {
                PanelWidgetClass SentinelUIPurgeAccent
                {
                    ignorepointer 1
                    position 0 0
                    size 1 0.035
                    hexactpos 0
                    vexactpos 0
                    hexactsize 0
                    vexactsize 0
                    color 0.95 0.06 0.08 1
                }

                ImageWidgetClass SentinelUIPurgeIcon
                {
                    ignorepointer 1
                    position 0.03 0.20
                    size 0.15 0.60
                    hexactpos 0
                    vexactpos 0
                    hexactsize 0
                    vexactsize 0
                    fixaspect fixheight
                    image0 "SentinelUI/gui/icons/purge_ca.paa"
                    mode blend
                    "src alpha" 1
                    stretch 1
                    filter 1
                    nocache 0
                }

                TextWidgetClass SentinelUIPurgeTitle
                {
                    ignorepointer 1
                    position 0.19 0.12
                    size 0.78 0.25
                    text "PURGE BEGINS IN"
                    font "gui/fonts/sdf_MetronBook24"
                    text_proportional 1
                    text_halign center
                    text_valign center
                    color 1 0.28 0.28 1
                }

                TextWidgetClass SentinelUIPurgeValue
                {
                    ignorepointer 1
                    position 0.19 0.34
                    size 0.78 0.36
                    text "5"
                    font "gui/fonts/sdf_MetronBook24"
                    text_proportional 1
                    text_halign center
                    text_valign center
                    color 1 1 1 1
                }

                TextWidgetClass SentinelUIPurgeSubtitle
                {
                    ignorepointer 1
                    position 0.19 0.72
                    size 0.78 0.16
                    text "WEEKEND PURGE"
                    font "gui/fonts/sdf_MetronBook24"
                    text_proportional 1
                    text_halign center
                    text_valign center
                    color 0.88 0.88 0.88 1
                }
            }
        }
